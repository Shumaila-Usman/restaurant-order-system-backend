# ─── Central MongoDB ─────────────────────────────────────────────────────────
# Your Atlas connection string. Do NOT include a database name in the URI —
# the backend always uses restaurant_order_system_v2 (set in src/config/db.js).
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ─── Admin JWT ───────────────────────────────────────────────────────────────
ADMIN_JWT_SECRET=replace_with_another_long_random_secret
ADMIN_JWT_EXPIRES_IN=1d

# ─── Cron security token ─────────────────────────────────────────────────────
CRON_SECRET=replace_with_cron_secret_token

# ─── Firebase Admin SDK ──────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# OR for Vercel (base64-encoded JSON):
# FIREBASE_SERVICE_ACCOUNT_BASE64=<base64_encoded_json>

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Seed / Init script values ───────────────────────────────────────────────
SEED_ADMIN_NAME=Local Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!

# Source DB URI for the test restaurant seed
# Leave blank to reuse the same Atlas cluster (different DB: test_restaurant_source)
TEST_SOURCE_DB_URI=

# Set to true to reset test user passwords on db:init
RESET_TEST_PASSWORDS=false

# ─── Credential Encryption ───────────────────────────────────────────────────
# AES-256-GCM key for encrypting stored credentials (app passwords, website admin passwords).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# REQUIRED in production. In development a fallback key is used with a warning.
CREDENTIAL_ENCRYPTION_KEY=replace_with_32_byte_base64_key
